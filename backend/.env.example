# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careernexus?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/careernexus_test

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=change-this-cookie-secret-too

# Email (SMTP — e.g. Gmail App Password, SendGrid, Mailtrap for dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
EMAIL_FROM="CareerNexus <no-reply@careernexus.io>"

# File uploads
MAX_FILE_SIZE_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=200
